{
  "name": "drezivo-media-staging",
  "main": "edge/media-worker/worker.mjs",
  "compatibility_date": "2026-10-28",
  "vars": {
    "API_ORIGIN": "https://api-preview.drezivo.shop"
  },
  "routes": [
    {
      "pattern": "api-preview.drezivo.shop/api/media/public/*",
      "zone_name": "drezivo.shop"
    }
  ],
  "preview_urls": true,
  "workers_dev": false
}
