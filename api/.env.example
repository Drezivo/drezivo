## API environment template — no real credential belongs in this file.
## Copy this template to the ignored `.env` file, then replace the development credentials there.

NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://drezivo@127.0.0.1:5432/drezivo
DATABASE_URL_DIRECT=postgresql://drezivo@127.0.0.1:5432/drezivo
DATABASE_POOL_MAX=10
POSTGRES_PASSWORD=change-me

CLERK_SECRET_KEY=sk_test_replace_with_your_development_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_development_publishable_key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_replace_with_your_development_webhook_secret
CORS_ALLOWED_ORIGINS=http://localhost:3000
INVITATION_EMAIL_ENCRYPTION_KEY=replace_with_32_byte_base64url_key
INVITATION_EMAIL_DIGEST_KEY=replace_with_a_different_32_byte_base64url_key

AWS_REGION=us-east-1
S3_BUCKET_PRIVATE=drezivo-private
S3_BUCKET_PUBLIC=drezivo-public
S3_ACCESS_KEY_ID=drezivo-local-admin
S3_SECRET_ACCESS_KEY=replace_with_the_same_value_as_MINIO_ROOT_PASSWORD
MINIO_ROOT_USER=drezivo-local-admin
MINIO_ROOT_PASSWORD=replace_with_a_unique_local_password
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true

LOG_LEVEL=debug
WORKER_ENABLED=false
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60
IDEMPOTENCY_RETENTION_DAYS=7
