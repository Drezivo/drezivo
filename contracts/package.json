{
  "name": "@drezivo/contracts",
  "version": "0.2.0",
  "description": "Drezivo HTTP API contract — Zod schemas and generated OpenAPI 3.1 shared by api, app, and web.",
  "license": "UNLICENSED",
  "private": false,
  "sideEffects": false,
  "type": "commonjs",
  "engines": {
    "node": ">=22 <25"
  },
  "files": [
    "dist",
    "openapi"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./openapi/drezivo.v1.yaml": "./openapi/drezivo.v1.yaml",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Drezivoo/contracts.git"
  },
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "openapi:generate": "tsx openapi/generate.ts",
    "prepare": "husky"
  },
  "peerDependencies": {
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "lint-staged": "^17.5.1",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.12.2",
    "vitest": "^5.0.1",
    "yaml": "^2.6.0",
    "zod": "^3.23.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
