{
  "name": "@drezivo/web",
  "version": "0.1.0",
  "private": true,
  "description": "Drezivo public surface — marketing site and tenant storefront + guest booking flow (drezivo.com).",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "npm run build --workspace @drezivo/contracts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@drezivo/contracts": "0.2.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@gsap/react": "2.1.2",
    "@tanstack/react-query": "^5.59.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "3.10.1",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "next": "15.5.24",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.180.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "husky": "^9.1.6",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
